# GEMINI_API_KEY: Required for Gemini AI API calls if AI features are enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where this application is hosted.
APP_URL="MY_APP_URL"

# =====================================================================
# SERVER-ONLY SUPABASE + SESSION CONFIGURATION (NEVER prefix with VITE_)
# =====================================================================

# Supabase Project URL (server-side Express API & migration script)
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"

# Supabase Secret / Service Role key (NEVER expose to frontend / Vite)
SUPABASE_SECRET_KEY="YOUR_SUPABASE_SECRET_OR_SERVICE_ROLE_KEY"

# Required in production (minimum 32 random characters).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS"
